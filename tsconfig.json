{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "nodenext",
    "allowJs": true,
    "types": ["@playwright/test", "node"]
  },
  "include": ["**/*.ts", "**/*.json"],
  "exclude": ["node_modules", "dist", "playwright-report"]
}
