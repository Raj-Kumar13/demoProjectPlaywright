        {
            "and": [
                {
                    "equals": {
                        "method": "POST"
                    }
                },
                {
                    "equals": {
                        "path": "/auth/login"
                    }
                },
                {
                    "equals": {
                        "body": "{\"email\":\"john@test.com\",\"password\":\"Password123\"}"
                    }
                }
            ]
